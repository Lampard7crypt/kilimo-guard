# Google Gemini / Gemma API Configuration
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemma Models (Defaults to Google's general-purpose Gemma 4 models on Gemini API)
GEMMA_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it
GEMMA_RETRIES_PER_MODEL=2
GEMMA_BASE_DELAY_S=1.0
GEMMA_TIMEOUT_S=35

# DigitalOcean Managed Database (PostgreSQL)
# e.g. postgresql://doadmin:secret@db-postgresql-nyc3-xxxxx.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# If left empty, KilimoGuard automatically defaults to a local SQLite database (sqlite:///./kilimoguard.db)
DATABASE_URL=

# DigitalOcean Spaces (S3-Compatible Object Storage for Crop Photos & Receipts)
# e.g. Region: nyc3, ams3, fra1, sgp1
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=kilimo-guard-storage
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# If DO Spaces credentials are not configured, KilimoGuard automatically stores uploads in local /uploads folder

# Server Configuration
PORT=8000
HOST=0.0.0.0
